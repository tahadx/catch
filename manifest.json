{
  "schemaVersion": 1,
  "id": "io.github.tahadx.catch",
  "name": "Catch",
  "version": "0.0.1",
  "author": "Taha Sadough",
  "license": "MIT",
  "description": "Native download manager for Omarchy: bar status, Rust backend, browser handoff.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Catch",
    "description": "Download queue status. Click opens the download folder.",
    "category": "Files",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "catchCommand": "catch",
      "downloadDir": "",
      "maxParallel": 3
    },
    "schema": [
      {
        "key": "catchCommand",
        "type": "string",
        "label": "Catch command (name on PATH or absolute path)",
        "defaultValue": "catch"
      },
      {
        "key": "downloadDir",
        "type": "string",
        "label": "Download folder (empty = ~/Downloads/catch)",
        "defaultValue": ""
      },
      {
        "key": "maxParallel",
        "type": "enum",
        "label": "Parallel downloads",
        "options": [
          1,
          3,
          5,
          10
        ],
        "defaultValue": 3,
        "description": "How many files download at once; the rest wait queued."
      }
    ]
  }
}

{
  "manifest_version": 3,
  "name": "Catch",
  "version": "0.1.1",
  "description": "Send downloads to the native Catch download manager.",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Catch this download",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "catch-download": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Send the current page/file to Catch"
    }
  },
  "background": {
    "service_worker": "background-3.js"
  },
  "key": ""
}

#!/bin/bash
# Self-configure a Catch install: link backend binaries, write browser host
# manifests, and install the cleanup helper. Idempotent and quiet when
# everything is already in place. Runs automatically from the shell plugin on
# startup; safe to run by hand.
# (Chromium, Brave, and Edge pick the extension up from their flags files;
# Chrome and the Firefox family need a one-time manual load. See README.)
set -euo pipefail

# We are the self-configure step. Children must not ask to self-configure
# again: the links and host manifests do not exist until this script finishes.
export CATCH_NO_SELF_CONFIGURE=1

PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
DIST="$PLUGIN_DIR/bin/dist"
BIN_DIR="$HOME/.local/bin"
HELPER="$BIN_DIR/catch-uninstall"

need_setup=0
[[ -x "$BIN_DIR/catch" ]] || need_setup=1
[[ -x "$BIN_DIR/catch-host" ]] || need_setup=1
# The helper must be a real copy, not a link into the plugin tree: Omarchy
# deletes a git checkout on `plugin remove` without running its code, so a
# link would break before the user could clean up the browser flags.
[[ -x "$HELPER" && ! -L "$HELPER" ]] || need_setup=1
if [[ -f "$HELPER" ]] && ! cmp -s -- "$PLUGIN_DIR/bin/uninstall" "$HELPER"; then
  need_setup=1
fi
[[ -f "$HOME/.config/chromium/NativeMessagingHosts/io.github.tahadx.catch.json" ]] || need_setup=1
[[ -f "$HOME/.mozilla/native-messaging-hosts/io.github.tahadx.catch.json" ]] || need_setup=1

if (( need_setup == 0 )); then
  exit 0
fi

if [[ ! -x "$DIST/catch" || ! -x "$DIST/catch-host" ]]; then
  echo "catch: backend missing or not executable in $DIST" >&2
  echo "catch: run bin/refresh-dist (or reinstall the plugin)" >&2
  exit 1
fi

# Executing the shipped binary catches a package built for another CPU
# (exec format error) before it is linked into the user's PATH.
DIST_VERSION="$("$DIST/catch" --version 2>/dev/null | awk 'NR == 1 { print $2 }')"
MANIFEST_VERSION="$(sed -n 's/^[[:space:]]*"version": "\([^"]*\)".*/\1/p' "$PLUGIN_DIR/manifest.json" | head -n 1)"
if [[ -z "$DIST_VERSION" ]]; then
  echo "catch: cannot execute $DIST/catch on this machine" >&2
  exit 1
fi
if [[ -n "$MANIFEST_VERSION" && "$DIST_VERSION" != "$MANIFEST_VERSION" ]]; then
  echo "catch: shipped backend is $DIST_VERSION but the plugin is $MANIFEST_VERSION" >&2
  echo "catch: reinstall the plugin or run bin/refresh-dist" >&2
  exit 1
fi

mkdir -p -- "$BIN_DIR"
ln -sfn -- "$DIST/catch" "$BIN_DIR/catch"
ln -sfn -- "$DIST/catch-host" "$BIN_DIR/catch-host"
# A real copy survives deletion of the plugin directory. The script removes
# this copy itself when it runs, so cleanup does not leave another leftover.
install -m 0755 -- "$PLUGIN_DIR/bin/uninstall" "$HELPER"

"$BIN_DIR/catch" install-hosts >/dev/null
"$BIN_DIR/catch" install-extension >/dev/null || true

echo "catch: configured backend + browser hosts + cleanup helper"

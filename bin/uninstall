#!/bin/bash
# Remove everything Catch installs outside its own plugin directory:
# backend symlinks, browser host manifests, browser flags entries, the
# scheduler timer, and the cleanup helper itself. Idempotent; safe to re-run.
# Queue records and downloaded files are user data and stay untouched.
#
# This file is also installed as ~/.local/bin/catch-uninstall (a real copy,
# not a symlink), so it still works after Omarchy's Remove Plugin deletes the
# checkout without running anything inside it.
# Usage: ./bin/uninstall
set -euo pipefail

HOST_NAME="io.github.tahadx.catch"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
BINDINGS="$CONFIG_HOME/hypr/bindings.lua"
BIND_LINE="o.bind(\"SUPER + D\", \"Catch downloads\", \"omarchy-shell shell toggle io.github.tahadx.catch '{}'\")"

echo "== Catch: removing installed pieces =="

# 1. Scheduler timer (units we own, then reload).
systemctl --user disable --now catch-schedule.timer 2>/dev/null || true
rm -f "$HOME/.config/systemd/user/catch-schedule.timer" \
  "$HOME/.config/systemd/user/catch-schedule.service"
systemctl --user daemon-reload 2>/dev/null || true
echo "  scheduler timer removed"

# 2. Backend symlinks, only when they point at a catch tree. Checking the
# shape of the target, not just the word "catch", keeps an unrelated link
# such as ~/bin/my-catch-helper from being deleted.
for bin in catch catch-host; do
  link="$HOME/.local/bin/$bin"
  if [[ -L "$link" ]]; then
    target="$(readlink -- "$link")"
    case "$target" in
      */bin/dist/"$bin"|*/target/debug/"$bin"|*/target/release/"$bin")
        rm -f -- "$link"
        echo "  unlinked $link"
        ;;
    esac
  fi
done

# 3. Our Super+D line, preserving every other binding byte for byte.
if [[ -f "$BINDINGS" ]] && grep -qxF -- "$BIND_LINE" "$BINDINGS"; then
  python3 - "$BINDINGS" "$BIND_LINE" <<'PY'
import sys
path, line = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as f:
    lines = f.readlines()
kept = [l for l in lines if l.rstrip("\n") != line]
if len(kept) != len(lines):
    with open(path, "w", encoding="utf-8") as f:
        f.writelines(kept)
PY
  echo "  removed Super+D bindings entry"
fi

# 4. Native host manifests, both families.
rm -f \
  "$HOME"/.config/chromium/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.config/google-chrome/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.config/google-chrome-beta/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.config/google-chrome-unstable/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.config/BraveSoftware/Brave-Browser/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.config/BraveSoftware/Brave-Browser-Beta/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.config/BraveSoftware/Brave-Browser-Nightly/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.config/BraveSoftware/Brave-Origin/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.config/BraveSoftware/Brave-Origin-Beta/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.config/BraveSoftware/Brave-Origin-Nightly/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.config/microsoft-edge/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.config/microsoft-edge-dev/NativeMessagingHosts/$HOST_NAME.json \
  "$HOME"/.mozilla/native-messaging-hosts/$HOST_NAME.json \
  "$HOME"/.zen/native-messaging-hosts/$HOST_NAME.json \
  "$HOME"/.librewolf/native-messaging-hosts/$HOST_NAME.json \
  "$HOME"/.floorp/native-messaging-hosts/$HOST_NAME.json \
  "$HOME"/.waterfox/native-messaging-hosts/$HOST_NAME.json
echo "  host manifests removed"

# 5. Our extension path out of every Chromium flags file. Omarchy's own
# entries stay; a flag left with nothing on it is dropped.
python3 - <<'EOF'
import os
config = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
changed = 0
for name in ("chromium-flags.conf", "chrome-flags.conf", "brave-flags.conf",
             "brave-origin-flags.conf", "microsoft-edge-flags.conf",
             "microsoft-edge-dev-flags.conf"):
    path = os.path.join(config, name)
    if not os.path.isfile(path):
        continue
    with open(path) as f:
        lines = f.read().splitlines()
    out = []
    for line in lines:
        if not line.startswith("--load-extension="):
            out.append(line)
            continue
        rest = [p for p in line.split("=", 1)[1].split(",")
                if p and "tahadx.catch" not in p
                and not p.endswith("extensions/chromium-catch")]
        if rest:
            out.append("--load-extension=" + ",".join(rest))
            if len(rest) != len(line.split("=", 1)[1].split(",")):
                changed += 1
    if out != lines:
        with open(path, "w") as f:
            f.write("\n".join(out) + ("\n" if out else ""))
        changed += 1
print(f"  flags files cleaned")
EOF

# 6. The stored helper. Keep this last so a failed cleanup can still be
# retried with the same copy. Removing a running script is safe on Linux.
HELPER="$HOME/.local/bin/catch-uninstall"
if [[ -e "$HELPER" || -L "$HELPER" ]]; then
  rm -f -- "$HELPER"
  echo "  removed $HELPER"
fi

echo "Done. Your queue and ~/Downloads/catch are untouched."
echo "Finish with: omarchy plugin remove io.github.tahadx.catch"
